
pipeline {
    agent {label 'jenkinsworker'}

    environment {
        DOCKER_IMAGE = 'saikishorea/mini-ecommerce'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                git changelog: false,
                    poll: false,
                    url: 'https://github.com/alavalapatikishore/ecommercenov.git'
            }
        }

        stage('Validate Source') {
            steps {
                sh '''
                    test -f pom.xml
                    test -f Dockerfile
                    test -d src

                    echo "Source validation successful"
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build --pull \
                        -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                        -t ${DOCKER_IMAGE}:latest .
                '''
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        export DOCKER_CONFIG=$(mktemp -d)

                        cleanup() {
                            docker logout || true
                            rm -rf "$DOCKER_CONFIG"
                        }

                        trap cleanup EXIT

                        echo "$DOCKER_TOKEN" | docker login \
                            -u "$DOCKER_USER" --password-stdin

                        docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}

                        docker push ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'E-commerce image successfully pushed to Docker Hub!'
            echo 'Image version: saikishorea/mini-ecommerce:${BUILD_NUMBER}'
        }

        failure {
            echo 'Pipeline failed. Check Jenkins console output.'
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}
